PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=instacard
DB_USER=postgres
DB_PASS=your_password

# JWT
JWT_SECRET=change-this-to-strong-random-64-chars
JWT_EXPIRES_IN=7d

# Redis (for idempotency + distributed locks)
REDIS_URL=redis://localhost:6379

# MTN MoMo API
MTN_API_BASE=https://sandbox.momodeveloper.mtn.com
MTN_API_KEY=
MTN_API_SECRET=
MTN_SUBSCRIPTION_KEY=
MTN_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=https://yourdomain.com/api/webhooks/mtn

# Airtel Money API
AIRTEL_API_BASE=https://openapi.sandbox.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_URL=https://yourdomain.com/api/webhooks/airtel

# FX Rate API
FX_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# SMS Provider (Africa's Talking)
AT_API_BASE=https://api.africastalking.com
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=InstaCard
AT_ENVIRONMENT=production

# Security
WEBHOOK_SECRET=change-this-random-string
ADMIN_BOOTSTRAP_TOKEN=change-this-random-string

# First admin (used by `npm run db:seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_NAME=
